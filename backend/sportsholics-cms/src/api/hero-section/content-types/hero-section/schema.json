{
  "kind": "collectionType",
  "collectionName": "hero_sections",
  "info": {
    "singularName": "hero-section",
    "pluralName": "hero-sections",
    "displayName": "Hero Section",
    "description": "Homepage hero section content"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "titleHighlight": {
      "type": "string",
      "required": false
    },
    "description": {
      "type": "text",
      "required": true
    },
    "categoryLabel": {
      "type": "string",
      "required": true,
      "default": "Ποδόσφαιρο"
    },
    "categoryEmoji": {
      "type": "string",
      "required": false,
      "default": "🔥"
    },
    "timeAgo": {
      "type": "string",
      "required": false,
      "default": "5 λεπτά πριν"
    },
    "buttonText": {
      "type": "string",
      "required": true,
      "default": "Διαβάστε περισσότερα →"
    },
    "linkedFootballArticle": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::football-article.football-article"
    },
    "linkedBasketballArticle": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::basketball-article.basketball-article"
    },
    "linkedFormula1Article": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::formula1-article.formula1-article"
    },
    "linkedNewsArticle": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::news-article.news-article"
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "isActive": {
      "type": "boolean",
      "default": false
    }
  }
}

